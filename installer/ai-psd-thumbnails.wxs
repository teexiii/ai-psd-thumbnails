<?xml version="1.0" encoding="utf-8"?>
<!--
  ai-psd-thumbnails MSI package root.
  Platform: x64, per-machine (ALLUSERS=1), WiX v4.
  UpgradeCode: F4B5BFA4-F277-4D9A-B8C2-7EF38B0357B9  (fixed for lifetime of product)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
      Name="ai-psd-thumbnails"
      Manufacturer="ai-psd-thumbnails contributors"
      Version="0.4.0"
      UpgradeCode="F4B5BFA4-F277-4D9A-B8C2-7EF38B0357B9"
      Language="1033"
      Codepage="1252"
      InstallerVersion="500"
      Scope="perMachine">

    <!--
      MajorUpgrade: schedule RemoveExistingProducts after InstallInitialize so
      old files are removed before new files land (clean upgrade, no key-file conflicts).
    -->
    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of ai-psd-thumbnails is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      RestartManager: ask processes holding the DLL to release it on upgrade/uninstall.
      Uses the real WiX 4 util:RestartResource element (util:RestartResourceCleanup does
      not exist â€” do not use it). Real-world effect on shell-extension DLLs is limited
      (Explorer reloads handlers on demand; dllhost/prevhost surrogates are transient),
      but RM avoids a forced reboot in the common single-user case.
    -->
    <util:RestartResource Path="[INSTALLFOLDER]thumb_viewer.dll" />

    <Feature Id="Complete" Title="ai-psd-thumbnails Shell Extension" Level="1"
             Display="hidden" AllowAbsent="no" AllowAdvertise="no">
      <!-- File components -->
      <ComponentRef Id="CMP_ThumbViewerDll" />
      <ComponentRef Id="CMP_PdfiumDll" />

      <!-- Registry: CLSID-A (thumbnail provider) InprocServer32 -->
      <ComponentRef Id="CMP_RegClsidA_InprocServer32" />

      <!-- Registry: CLSID-B (preview handler) InprocServer32 + AppID value + display name -->
      <ComponentRef Id="CMP_RegClsidB_InprocServer32" />
      <ComponentRef Id="CMP_RegClsidB_AppIdValue" />
      <ComponentRef Id="CMP_RegClsidB_DisplayName" />

      <!-- Registry: PreviewHandlers enumeration entry -->
      <ComponentRef Id="CMP_RegPreviewHandlers" />

      <!-- Installed-marker component (provides an uninstall-clean HKLM key) -->
      <ComponentRef Id="CMP_InstallMarker" />
    </Feature>

    <!-- Stable feature IDs preserve choices across future major upgrades.
         Keep existing registry component GUIDs and key paths unchanged. -->

    <Feature Id="Handler_AI" Title="AI" Level="1" AllowAdvertise="no">
      <ComponentRef Id="CMP_RegShellEx_Ai_Thumb" />
      <ComponentRef Id="CMP_RegShellEx_Ai_Preview" />
    </Feature>

    <Feature Id="Handler_PSD" Title="PSD" Level="1" AllowAdvertise="no">
      <ComponentRef Id="CMP_RegShellEx_Psd_Thumb" />
      <ComponentRef Id="CMP_RegShellEx_Psd_Preview" />
    </Feature>

    <Feature Id="Handler_PSB" Title="PSB" Level="1" AllowAdvertise="no">
      <ComponentRef Id="CMP_RegShellEx_Psb_Thumb" />
      <ComponentRef Id="CMP_RegShellEx_Psb_Preview" />
    </Feature>

    <Feature Id="Handler_EPS" Title="EPS" Level="1" AllowAdvertise="no">
      <ComponentRef Id="CMP_RegShellEx_Eps_Thumb" />
      <ComponentRef Id="CMP_RegShellEx_Eps_Preview" />
    </Feature>

    <Feature Id="Handler_PDF" Title="PDF" Level="1" AllowAdvertise="no">
      <ComponentRef Id="CMP_RegShellEx_Pdf_Thumb" />
    </Feature>

    <Feature Id="Handler_SVG" Title="SVG" Level="1" AllowAdvertise="no">
      <ComponentRef Id="CMP_RegShellEx_Svg_Thumb" />
      <ComponentRef Id="CMP_RegShellEx_Svg_Preview" />
    </Feature>

    <UIRef Id="FormatSelectionUI" />

    <!--
      Custom action: CA_RestoreAiProgId
        Type: BinaryRef + ExeCommand â†’ MSI type 18 (run embedded exe with command line).
        Execute: deferred â€” runs elevated (as SYSTEM / LocalSystem) inside the execute script,
                 which is required to write HKCR (= HKLM\SOFTWARE\Classes) on per-machine installs.
        Impersonate: no â€” stays as SYSTEM; needed to write per-machine HKCR\.ai.
        Return: check â€” non-zero exit aborts the install with an error.
        Condition: &amp;Handler_AI = 3: runs only when AI is selected locally.
        The exe reads HKCR\.ai default; if it equals "SageThumbsImage.ai" (SageThumbs leftover)
        it restores it to "Adobe.Illustrator.28". Any other value is left untouched.
        Per-user leftovers in HKCU\Software\Classes\.ai or FileExts\.ai\UserChoice are
        out of scope (SYSTEM's HKCR view = HKLM\SOFTWARE\Classes only).

      Custom action: CA_NotifyAssocChanged
        Type: BinaryRef + ExeCommand â†’ MSI type 18.
        Execute: commit â€” runs after the transaction commits, not rollback-able.
        Impersonate: yes â€” MUST run in the user's interactive session so that
                     SHChangeNotify(SHCNE_ASSOCCHANGED) broadcasts reach the running Explorer.
                     A deferred no-impersonate CA executes as SYSTEM in session 0; SHChangeNotify
                     from session 0 only broadcasts within session 0 â€” the user's Explorer never
                     receives it (silent no-op). Impersonation puts the CA in the user session.
        Return: ignore â€” notification is best-effort; a failed broadcast is non-fatal.
                (asyncNoWait is unsupported for in-script CAs; ignore is the correct choice.)
        Condition: NOT UPGRADINGPRODUCTCODE: refreshes changes and final uninstall.
        Sequencing: Before="InstallFinalize" â€” commit CAs must be inside the
                    InstallInitialize..InstallFinalize window; After="InstallFinalize"
                    is illegal for in-script CAs (MSI error 2762).
    -->

    <Binary Id="InstallerCaBin" SourceFile="payload\installer-ca.exe" />

    <CustomAction
        Id="CA_RestoreAiProgId"
        BinaryRef="InstallerCaBin"
        ExeCommand="restore-ai-progid"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <CustomAction
        Id="CA_NotifyAssocChanged"
        BinaryRef="InstallerCaBin"
        ExeCommand="notify-assoc-changed"
        Execute="commit"
        Impersonate="yes"
        Return="ignore" />

    <InstallExecuteSequence>
      <!--
        CA_RestoreAiProgId: deferred, elevated, after registry components are written
        (WriteRegistryValues) and before the transaction is finalised (InstallFinalize).
      -->
      <Custom Action="CA_RestoreAiProgId" After="WriteRegistryValues" Condition="&amp;Handler_AI = 3" />

      <!--
        CA_NotifyAssocChanged: commit, impersonated, sequenced BEFORE InstallFinalize.
        MSI rule: deferred/rollback/commit CAs must be sequenced between
        InstallInitialize and InstallFinalize (the commit script is written into the
        execute script; sequencing after InstallFinalize is invalid and causes error
        2762 or silent no-run depending on MSI engine version).
        Return="ignore" â€” a missed notification is non-fatal; the host will refresh
        associations on next Explorer restart.
      -->
      <Custom Action="CA_NotifyAssocChanged" Before="InstallFinalize" Condition="NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>

  <!-- â”€â”€ Install directory layout â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ai-psd-thumbnails" />
    </StandardDirectory>
  </Fragment>

  <!-- â”€â”€ File components â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->

  <Fragment>
    <ComponentGroup Id="CG_Files" Directory="INSTALLFOLDER">

      <!-- thumb_viewer.dll â€” COM shell extension; KeyPath anchors the component -->
      <Component Id="CMP_ThumbViewerDll" Guid="FB6052C0-546D-41B4-A418-D075AE72F3F1">
        <File Id="FILE_ThumbViewerDll"
              Name="thumb_viewer.dll"
              Source="payload\thumb_viewer.dll"
              KeyPath="yes" />
      </Component>

      <!-- pdfium.dll â€” must reside in the same directory as thumb_viewer.dll so that
           pdfium_path.rs GetModuleFileNameW sibling-path resolution finds it at runtime -->
      <Component Id="CMP_PdfiumDll" Guid="C25CEFC2-4B40-4A77-A9EF-D97B8F85C922">
        <File Id="FILE_PdfiumDll"
              Name="pdfium.dll"
              Source="payload\pdfium.dll"
              KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- â”€â”€ Install marker component â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->

  <Fragment>
    <Component Id="CMP_InstallMarker"
               Directory="INSTALLFOLDER"
               Guid="A22A4C0D-F194-4FA2-BB46-D0447D51A755">
      <!--
        Lightweight presence marker in HKLM.  Gives a stable KeyPath for this component
        and provides a machine-readable install detection point.
        Removed on uninstall; the key is ours alone (not shared with any OS component).
      -->
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\ai-psd-thumbnails"
          Name="Version"
          Type="string"
          Value="0.4.0"
          KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>




